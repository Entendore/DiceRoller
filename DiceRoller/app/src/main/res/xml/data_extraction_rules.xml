<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/"/>
        <include domain="sharedpref" path="dice_prefs.xml"/>
        <include domain="sharedpref" path="dice_theme.xml"/>
        <exclude domain="file" path="last_crash.txt"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/"/>
        <include domain="sharedpref" path="dice_prefs.xml"/>
        <include domain="sharedpref" path="dice_theme.xml"/>
        <exclude domain="file" path="last_crash.txt"/>
    </device-transfer>
</data-extraction-rules>
